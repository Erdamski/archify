{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/common.schema.json",
  "title": "Archify Shared Definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "locale": {
      "enum": ["en", "zh-CN", "de"]
    },
    "details": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Plain-text reader notes shown in the viewer detail popover. Blank lines separate paragraphs; lines starting with '- ' form a list. Never interpreted as HTML."
    },
    "edgeDetails": {
      "anyOf": [
        { "$ref": "#/$defs/details" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "forward": { "$ref": "#/$defs/details" },
            "back": { "$ref": "#/$defs/details" }
          }
        }
      ],
      "description": "Reader notes for a relationship: one text, or separate texts for the forward (from -> to) and back (to -> from) direction."
    },
    "accent": {
      "enum": ["red", "orange", "amber", "yellow", "lime", "green", "teal", "cyan", "blue", "indigo", "violet", "pink", "slate"],
      "description": "Optional color override from a fixed token palette. The semantic type keeps its sigil and legend meaning."
    },
    "relativeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*(?:#[A-Za-z][A-Za-z0-9_-]*)?$",
      "description": "A file name next to the rendered HTML, optionally with a fragment (it-briefing.html or it-briefing.html#res-4). No scheme, no slash, no '..', no query: the reference can only point at a sibling file."
    },
    "viewerLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$" },
        "href": { "$ref": "#/$defs/relativeRef" }
      }
    },
    "viewerOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "click_zoom": { "type": "boolean" },
        "detail_placement": { "enum": ["anchored", "docked"] },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/viewerLink" },
          "description": "Toolbar links to sibling documents, rendered beside Present and Export; they open in the same tab."
        }
      }
    },
    "animation": {
      "enum": ["trace", "none"]
    },
    "visualPreset": {
      "enum": ["classic", "signal-flow", "blueprint", "editorial"]
    },
    "qualityProfile": {
      "enum": ["standard", "showcase"]
    },
    "side": {
      "enum": ["left", "right", "top", "bottom"]
    },
    "relationshipWidth": {
      "type": "number",
      "minimum": 0.5
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "componentType": {
      "enum": ["frontend", "backend", "database", "cloud", "security", "messagebus", "external"]
    },
    "brandMark": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "anyOf": [
            { "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
            { "pattern": "^https?://" }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https?://" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "variant": {
      "enum": ["default", "emphasis", "security", "dashed"]
    },
    "legendMode": {
      "enum": ["auto", "all", "hidden"]
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visible": { "type": "boolean" }
      }
    },
    "guidedViews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "focus"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "focus": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "note": { "type": "string", "maxLength": 140 }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dot", "title", "items"],
        "properties": {
          "dot": { "enum": ["cyan", "emerald", "violet", "amber", "rose", "orange", "slate"] },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
